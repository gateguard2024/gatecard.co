node_modules/
.pnp
.pnp.js

# Build output
.next/
out/
build/
dist/

# Environment files — NEVER commit these.
# The bare patterns are not enough: a backup like .env.local.pre-v8.31.bak
# slipped past them once and reached GitHub with live service-role keys in it.
.env*
!.env.example
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.production

# Vercel
.vercel

# TypeScript
*.tsbuildinfo
next-env.d.ts

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*

# Editor
.idea/
.vscode/
*.swp
*.swo

# Scratch tarball used to move source into the build sandbox
_stage.tgz
