# ─────────────────────────────────────────────────────────────────────────────
# GateCard — Nexus Resident Move-In Portal
# v8.31 — reset. Add a variable here only when the code actually reads it.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase ─────────────────────────────────────────────────────────────────
# DECISION PENDING: which project. Portal runs on jtvxfmhlmokyuzdxxqpp and owns
# organizations, sites, residents, service_catalog, commission_payouts.
# gatecard.co historically ran on lybwcmyvszzslcqxmrfl with its own sites/residents.
# The commission ledger cannot be built without the dealer hierarchy, which lives
# in portal's project. See docs/HANDOFF-move-in-portal.md §4.4.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Clerk — resident auth (§4.1) ─────────────────────────────────────────────
# Clerk organizations map to properties. Residents are org members.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# ── Stripe — optional items only (§4.3) ──────────────────────────────────────
# The mandatory parking + access fee NEVER touches Stripe. It rides the rent
# ledger. Stripe handles fobs, key tags, store merch, insurance, DirecTV,
# security deposits and monitoring subscriptions.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Stripe Connect — dealer payouts (§4.4) ───────────────────────────────────
# Express accounts. Separate charges and transfers, not application fees —
# the six-tier hierarchy means up to four parties on one transaction.
# Supabase owns the commission ledger; Stripe is the movement layer.
STRIPE_CONNECT_CLIENT_ID=
COMMISSION_HOLD_DAYS=30

# ── Brivo — roster in, credentials out (§5) ──────────────────────────────────
# Brivo is the PMS integration surface. Gate Guard never touches Yardi directly.
BRIVO_AUTH_BASIC=
BRIVO_API_KEY=
BRIVO_USERNAME=
BRIVO_PASSWORD=

# ── Shopify — merch catalogue and dropship fulfilment (see docs/SHOPIFY.md) ──
# Storefront token: public, read-only, used to render the catalogue.
SHOPIFY_STORE_DOMAIN=            # e.g. gateguard-store.myshopify.com
SHOPIFY_STOREFRONT_ACCESS_TOKEN=
# Admin token: secret. Creates the paid order after Stripe takes the money, so
# the dropship supplier actually ships. Scopes: write_orders, read_products.
SHOPIFY_ADMIN_ACCESS_TOKEN=
SHOPIFY_SHARED_COLLECTION=community-store

# ── Inngest — provisioning queue (§4.8) ──────────────────────────────────────
# Idempotent, retriable, status visible to the leasing office.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# ── Twilio — follow-up sequence (§7) ─────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ── Resend — staff digests and resident move-in invites ─────────────────────
RESEND_API_KEY=
RESEND_FROM_EMAIL=          # e.g. "East Ponds <noreply@gatecard.co>"
OPS_EMAIL=                  # fallback digest recipient when a site has no PM contact

# ── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://gatecard.co
